{
  "name": "client",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "tsc -b && eslint . --max-warnings=0 && prettier --check .",
    "format": "prettier --write .",
    "preview": "vite preview",
    "test": "vitest run src",
    "test:e2e": "playwright test",
    "test:coverage": "vitest run src --coverage"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@vitest/coverage-v8": "^5.1.0",
    "@tanstack/react-virtual": "^3.14.26",
    "axios": "^1.21.1",
    "emoji-picker-react": "^5.1.4",
    "firebase": "^13.3.0",
    "idb": "^8.0.4",
    "lucide-react": "^1.72.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.5",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@faker-js/faker": "^10.6.0",
    "@playwright/test": "^1.65.1",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "fake-indexeddb": "^6.2.8",
    "globals": "^17.13.0",
    "prettier": "^3.10.1",
    "typescript": "~6.0.3",
